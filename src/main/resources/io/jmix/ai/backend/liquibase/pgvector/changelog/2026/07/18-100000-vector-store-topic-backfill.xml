<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1" author="jmix-ai-backend" dbms="postgresql">
        <!-- Chunks ingested before the topic attribute existed never get rebuilt on their own
             (invalidation is by sourceHash + generationKey, metadata is not part of it), so the
             docs analytics would stay empty until a full re-ingest. Derives the topic exactly
             like DocsIngester.topicFromSource; embeddings are untouched. On a fresh database the
             vector_store table does not exist yet (Spring AI creates it later at startup) - the
             changeset is marked ran, which is correct: new ingests stamp the topic themselves. -->
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="vector_store"/>
        </preConditions>
        <sql>
            UPDATE vector_store
            SET metadata = jsonb_set(metadata::jsonb, '{topic}',
                to_jsonb(regexp_replace(split_part(metadata::jsonb->>'source','/',1), '\.html.*$','')))::json
            WHERE metadata::jsonb->>'type' IN ('docs','docs-snippets')
        </sql>
    </changeSet>
</databaseChangeLog>
