<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      xmlns:charts="http://jmix.io/schema/charts/ui"
      title="msg://vectorStoreEntityListView.title"
      focusComponent="vectorStoreDataGrid">
    <data>
        <collection id="vectorStoreDc"
                    class="io.jmix.ai.backend.entity.VectorStoreEntity">
            <loader id="vectorStoreDl" readOnly="true"/>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters id="urlQueryParameters">
            <pagination component="pagination"/>
        </urlQueryParameters>
        <settings auto="true"/>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <charts:chart id="coverageChart" width="100%" height="17em" minHeight="15em">
            <charts:title text="Corpus coverage — chunks by type and Jmix version"/>
            <charts:legend bottom="0"/>
            <charts:tooltip trigger="AXIS">
                <charts:axisPointer type="SHADOW"/>
            </charts:tooltip>
            <charts:xAxes>
                <charts:xAxis type="CATEGORY">
                    <charts:axisLabel rotate="20"/>
                </charts:xAxis>
            </charts:xAxes>
            <charts:yAxes>
                <charts:yAxis type="VALUE"/>
            </charts:yAxes>
            <charts:series>
                <charts:bar name="v2"/>
                <charts:bar name="v3"/>
            </charts:series>
        </charts:chart>
        <details id="topicDetails" summaryText="Documentation topic coverage (chunks per topic × version)"
                 opened="true" width="100%">
            <vbox id="topicHeatmapBox" width="100%"/>
        </details>
        <hbox alignItems="CENTER" width="100%">
            <span text="Metadata filter:" minWidth="8em"/>
            <textField id="filterField" width="100%" datatype="string">
                <suffix>
                    <hbox spacing="false">
                        <button id="filterClearButton" themeNames="tertiary-inline" icon="vaadin:close-small"
                                title="Clear"/>
                        <button id="filterHelpButton" themeNames="tertiary-inline" icon="vaadin:question-circle-o"
                                title="Help"/>
                    </hbox>
                </suffix>
            </textField>
        </hbox>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <comboButton id="updateButton" text="Update"/>
            <button id="readButton" action="vectorStoreDataGrid.readAction"/>
            <button id="removeButton" action="vectorStoreDataGrid.removeAction"/>
            <button id="removeAllButton" text="Remove All" themeNames="warning"/>
            <button id="refreshButton" action="vectorStoreDataGrid.refreshAction"/>
            <simplePagination id="pagination" dataLoader="vectorStoreDl"/>
        </hbox>
        <dataGrid id="vectorStoreDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="vectorStoreDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="readAction" type="list_read"/>
                <action id="removeAction" type="list_remove"/>
                <action id="refreshAction" type="list_refresh"/>
            </actions>
            <columns resizable="true" sortable="false">
                <column property="id"/>
                <column property="content"/>
                <column property="metadata"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
