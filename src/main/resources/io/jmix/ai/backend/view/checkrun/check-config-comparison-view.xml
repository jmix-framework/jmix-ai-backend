<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:charts="http://jmix.io/schema/charts/ui"
      title="A/B · config benchmark">
    <layout>
        <scroller width="100%" height="100%">
            <vbox width="100%" maxWidth="76em" padding="true" spacing="true">

                <vbox id="introBox" width="100%"/>

                <hbox id="winnerCards" width="100%" spacing="true"/>

                <hbox width="100%" spacing="true">
                    <charts:chart id="scoreChart" width="100%" height="24em" minWidth="20em">
                        <charts:title text="Average score (0–1, higher is better)"/>
                        <charts:legend bottom="0"/>
                        <charts:tooltip trigger="AXIS">
                            <charts:axisPointer type="SHADOW"/>
                        </charts:tooltip>
                        <charts:xAxes>
                            <charts:xAxis type="CATEGORY"/>
                        </charts:xAxes>
                        <charts:yAxes>
                            <charts:yAxis type="VALUE" min="0" max="1"/>
                        </charts:yAxes>
                        <charts:series>
                            <charts:bar name="v2">
                                <charts:itemStyle color="#5B8FF9"/>
                            </charts:bar>
                            <charts:bar name="v3">
                                <charts:itemStyle color="#5AD8A6"/>
                            </charts:bar>
                        </charts:series>
                    </charts:chart>

                    <charts:chart id="accuracyChart" width="100%" height="24em" minWidth="20em">
                        <charts:title text="Accuracy — share of answers ≥ 0.8 (higher is better)"/>
                        <charts:legend bottom="0"/>
                        <charts:tooltip trigger="AXIS">
                            <charts:axisPointer type="SHADOW"/>
                        </charts:tooltip>
                        <charts:xAxes>
                            <charts:xAxis type="CATEGORY"/>
                        </charts:xAxes>
                        <charts:yAxes>
                            <charts:yAxis type="VALUE" min="0" max="1"/>
                        </charts:yAxes>
                        <charts:series>
                            <charts:bar name="v2">
                                <charts:itemStyle color="#5B8FF9"/>
                            </charts:bar>
                            <charts:bar name="v3">
                                <charts:itemStyle color="#5AD8A6"/>
                            </charts:bar>
                        </charts:series>
                    </charts:chart>
                </hbox>

                <vbox id="shippedBox" width="100%" spacing="true"/>

            </vbox>
        </scroller>
    </layout>
</view>
